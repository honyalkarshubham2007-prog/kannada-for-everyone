[
{"id":"auto-cab","p":"auto","name":"Auto & Cab","kn":"ಆಟೋ ಮತ್ತು ಕ್ಯಾಬ್","icon":"car","blurb":"Get a fair ride and get off at the right place.",
"phrases":[
["ಮೀಟರ್ ಹಾಕಿ","meter haaki","Please put the meter on.","Say this before you sit. Some drivers quote a flat price otherwise."],
["ಎಷ್ಟು ಆಗುತ್ತದೆ?","eshtu aaguttade?","How much will it be?"],
["ಇಲ್ಲಿ ನಿಲ್ಲಿಸಿ","illi nillisi","Stop here, please."],
["ಬಲಕ್ಕೆ ತಿರುಗಿ","balakke thirugi","Turn right."],
["ಎಡಕ್ಕೆ ತಿರುಗಿ","edakke thirugi","Turn left."],
["ನೇರವಾಗಿ ಹೋಗಿ","neravaagi hogi","Go straight."],
["ಇಂದಿರಾನಗರಕ್ಕೆ ಬರ್ತೀರಾ?","indiranagarakke barteera?","Will you come to Indiranagar?","Swap in your own destination. If the driver says no or shakes his head, just ask the next one."],
["ಇಲ್ಲಿ ಕಾಯಿರಿ","illi kaayiri","Wait here."],
["ಚಿಲ್ಲರೆ ಇದೆಯಾ?","chillare ideya?","Do you have change?"],
["ಸ್ವಲ್ಪ ನಿಧಾನವಾಗಿ ಹೋಗಿ","swalpa nidhaanavaagi hogi","Please go a little slower."]],
"convo":[["y","ಇಂದಿರಾನಗರಕ್ಕೆ ಬರ್ತೀರಾ?","indiranagarakke barteera?","Will you come to Indiranagar?"],["t","ಬರ್ತೀನಿ. ಹತ್ತಿ.","barteeni. hatti.","I'll come. Get in."],["y","ಮೀಟರ್ ಹಾಕಿ.","meter haaki.","Put the meter on."],["t","ಹಾಕ್ತೀನಿ.","haakteeni.","Will do."],["y","ಇಲ್ಲಿ ನಿಲ್ಲಿಸಿ. ಎಷ್ಟು ಆಯ್ತು?","illi nillisi. eshtu aaytu?","Stop here. How much is it?"],["t","ನೂರ ಇಪ್ಪತ್ತು ರೂಪಾಯಿ.","nooru ippattu roopaayi.","120 rupees."]],
"tips":["Calling an auto driver 'anna' (elder brother) is friendly and normal.","Cab apps show the fare up front. For autos, ask for the meter."],
"avoid":["Don't start by arguing the price in English. A short 'meter haaki' works better."]},

{"id":"bus-metro","p":"bus","name":"BMTC Bus & Namma Metro","kn":"ಬಸ್ ಮತ್ತು ಮೆಟ್ರೋ","icon":"bus","blurb":"Find the right bus, buy a ticket, know your stop.",
"phrases":[
["ಬಸ್ ಸ್ಟಾಪ್ ಎಲ್ಲಿದೆ?","bus stop ellide?","Where is the bus stop?"],
["ಈ ಬಸ್ ಮೆಜೆಸ್ಟಿಕ್‌ಗೆ ಹೋಗುತ್ತದೆಯಾ?","ee bus majestic-ge hoguttadeya?","Does this bus go to Majestic?"],
["ಒಂದು ಟಿಕೆಟ್ ಕೊಡಿ","ondu ticket kodi","One ticket, please."],
["ಮುಂದಿನ ಸ್ಟಾಪ್ ಯಾವುದು?","mundina stop yaavudu?","What is the next stop?"],
["ನಾನು ಇಲ್ಲಿ ಇಳಿಯುತ್ತೇನೆ","naanu illi iliyuttene","I'll get off here.","Say it a stop early. Buses don't wait long."],
["ಮೆಟ್ರೋ ಸ್ಟೇಷನ್ ಎಲ್ಲಿದೆ?","metro station ellide?","Where is the metro station?"],
["ಟಿಕೆಟ್ ಎಷ್ಟು?","ticket eshtu?","How much is the ticket?"],
["ಈ ಬಸ್ ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತದೆ?","ee bus ellige hoguttade?","Where does this bus go?"],
["ನನ್ನ ಹತ್ತಿರ ಚಿಲ್ಲರೆ ಇಲ್ಲ","nanna hattira chillare illa","I don't have change.","Conductors prefer exact change for small fares."],
["ಮೆಜೆಸ್ಟಿಕ್ ಬಂದ್ರೆ ಹೇಳಿ","majestic bandre heli","Tell me when Majestic comes."]],
"convo":[["y","ಈ ಬಸ್ ಮೆಜೆಸ್ಟಿಕ್‌ಗೆ ಹೋಗುತ್ತದೆಯಾ?","ee bus majestic-ge hoguttadeya?","Does this bus go to Majestic?"],["t","ಹೌದು, ಹತ್ತಿ.","haudu, hatti.","Yes, get on."],["y","ಒಂದು ಟಿಕೆಟ್ ಕೊಡಿ.","ondu ticket kodi.","One ticket, please."],["t","ಇಪ್ಪತ್ತು ರೂಪಾಯಿ.","ippattu roopaayi.","20 rupees."],["y","ಮೆಜೆಸ್ಟಿಕ್ ಬಂದ್ರೆ ಹೇಳಿ.","majestic bandre heli.","Tell me when Majestic comes."]],
"tips":["Bus boards often show Kannada first. Learn to match the Kannada name of your stop.","Buses fill up fast. Move towards the exit before your stop."],
"avoid":["Don't wait for your stop to arrive before asking. Ask the conductor when you board."]},

{"id":"restaurant","p":"food","name":"Restaurant & Street Food","kn":"ಹೋಟೆಲ್ ಮತ್ತು ಊಟ","icon":"food","blurb":"Order, ask for less spice, and ask for the bill.",
"phrases":[
["ಒಂದು ಮಸಾಲೆ ದೋಸೆ ಕೊಡಿ","ondu masale dose kodi","One masala dosa, please."],
["ಖಾರ ಕಮ್ಮಿ ಮಾಡಿ","khaara kammi maadi","Make it less spicy.","In Karnataka, a 'hotel' usually means a restaurant, not a place to stay."],
["ನೀರು ಕೊಡಿ","neeru kodi","Water, please."],
["ಇದು ಏನು?","idu enu?","What is this?"],
["ಬಿಲ್ ಕೊಡಿ","bill kodi","The bill, please."],
["ಮೆನು ಕೊಡಿ","menu kodi","The menu, please."],
["ಒಂದು ಕಾಫಿ ಕೊಡಿ","ondu coffee kodi","One coffee, please."],
["ಇನ್ನೊಂದು ಕೊಡಿ","innondu kodi","One more, please."],
["ತುಂಬಾ ರುಚಿಯಾಗಿದೆ","tumba ruchiyaagide","It's very tasty.","Saying this to the cook or owner always lands well."],
["ನಾನು ಸಸ್ಯಾಹಾರಿ","naanu sasyaahaari","I'm vegetarian."]],
"convo":[["t","ಏನು ಬೇಕು?","enu beku?","What would you like?"],["y","ಒಂದು ಮಸಾಲೆ ದೋಸೆ ಕೊಡಿ.","ondu masale dose kodi.","One masala dosa, please."],["t","ಕಾಫಿ ಬೇಕಾ?","coffee bekaa?","Want coffee?"],["y","ಹೌದು, ಒಂದು ಕಾಫಿನೂ ಕೊಡಿ.","haudu, ondu coffeenu kodi.","Yes, one coffee too."],["y","ತುಂಬಾ ರುಚಿಯಾಗಿದೆ. ಬಿಲ್ ಕೊಡಿ.","tumba ruchiyaagide. bill kodi.","Very tasty. The bill, please."]],
"tips":["Many small eateries are 'darshini' style: stand, order at the counter, pay first.","Say 'khaara kammi' if you're unsure about spice."],
"avoid":["Don't call the waiter with a snap or a whistle. A raised hand and 'sir' is fine."]},

{"id":"market","p":"mkt","name":"Vegetable Market & Shopping","kn":"ಮಾರುಕಟ್ಟೆ","icon":"market","blurb":"Ask prices and bargain politely.",
"phrases":[
["ಟೊಮೆಟೊ ಕೆಜಿಗೆ ಎಷ್ಟು?","tomato kejige eshtu?","How much per kg for tomatoes?"],
["ಅರ್ಧ ಕೆಜಿ ಕೊಡಿ","ardha kg kodi","Half a kilo, please."],
["ಒಂದು ಕೆಜಿ ಕೊಡಿ","ondu kg kodi","One kilo, please."],
["ತುಂಬಾ ದುಬಾರಿ","tumba dubaari","Too expensive."],
["ಸ್ವಲ್ಪ ಕಮ್ಮಿ ಮಾಡಿ","swalpa kammi maadi","Reduce it a little.","Bargain with a smile. At street stalls it's expected."],
["ಇದು ತಾಜಾ ಇದೆಯಾ?","idu taaja ideya?","Is this fresh?"],
["ಕವರ್ ಬೇಡ","cover beda","No bag needed."],
["ಇದರ ಹೆಸರು ಏನು?","idara hesaru enu?","What is this called?"],
["ಇಷ್ಟು ಸಾಕು","ishtu saaku","That's enough."],
["ಫೋನ್‌ಪೇ ಇದೆಯಾ?","phonepe ideya?","Do you take PhonePe?","Most stalls accept UPI. Look for the QR code."]],
"convo":[["y","ಟೊಮೆಟೊ ಕೆಜಿಗೆ ಎಷ್ಟು?","tomato kejige eshtu?","How much per kg for tomatoes?"],["t","ಮೂವತ್ತು ರೂಪಾಯಿ.","moovattu roopaayi.","30 rupees."],["y","ತುಂಬಾ ದುಬಾರಿ. ಸ್ವಲ್ಪ ಕಮ್ಮಿ ಮಾಡಿ.","tumba dubaari. swalpa kammi maadi.","Too expensive. Reduce it a little."],["t","ಇಪ್ಪತ್ತೈದು ಕೊಡಿ.","ippattaidu kodi.","Give 25."],["y","ಸರಿ, ಅರ್ಧ ಕೆಜಿ ಕೊಡಿ.","sari, ardha kg kodi.","Okay, half a kilo please."]],
"tips":["Learn numbers 1 to 10 first. Prices are always spoken in Kannada.","Vendors often call out the price per kg. Listen before you ask."],
"avoid":["Don't bargain in a supermarket or a fixed-price shop."]},

{"id":"hospital","p":"med","name":"Hospital & Pharmacy","kn":"ಆಸ್ಪತ್ರೆ","icon":"health","blurb":"Explain how you feel and find the right counter.",
"phrases":[
["ನನಗೆ ಹುಷಾರಿಲ್ಲ","nanage hushaarilla","I'm not well."],
["ನನಗೆ ಜ್ವರ ಇದೆ","nanage jwara ide","I have a fever."],
["ನನಗೆ ತಲೆನೋವು","nanage thalenovu","I have a headache."],
["ನನಗೆ ಹೊಟ್ಟೆ ನೋವು","nanage hotte novu","I have a stomach ache."],
["ಡಾಕ್ಟರ್ ಎಲ್ಲಿ ಇದ್ದಾರೆ?","doctor elli iddaare?","Where is the doctor?"],
["ಈ ಮಾತ್ರೆ ಕೊಡಿ","ee maatre kodi","Please give me this tablet.","At a pharmacy, show the prescription or the strip. Names are usually in English."],
["ದಿನಕ್ಕೆ ಎರಡು ಸಲ","dinakke eradu sala","Twice a day."],
["ನನಗೆ ಅಲರ್ಜಿ ಇದೆ","nanage allergy ide","I have an allergy."],
["ಅಪಾಯಿಂಟ್‌ಮೆಂಟ್ ಬೇಕು","appointment beku","I need an appointment."],
["ಇಲ್ಲಿ ನೋವು ಇದೆ","illi novu ide","It hurts here.","Point to the spot as you say it."]],
"convo":[["t","ಏನು ತೊಂದರೆ?","enu tondare?","What's the problem?"],["y","ನನಗೆ ಜ್ವರ ಇದೆ.","nanage jwara ide.","I have a fever."],["t","ಎಷ್ಟು ದಿನದಿಂದ?","eshtu dinadinda?","Since how many days?"],["y","ಎರಡು ದಿನದಿಂದ.","eradu dinadinda.","Since two days."],["t","ಈ ಮಾತ್ರೆ ದಿನಕ್ಕೆ ಎರಡು ಸಲ ತಗೊಳ್ಳಿ.","ee maatre dinakke eradu sala tagolli.","Take this tablet twice a day."]],
"tips":["Doctors and pharmacists usually speak English. These phrases help with nurses, staff and signs."],
"avoid":["Don't self-prescribe from a phrasebook. Use these to reach the doctor, then follow their advice."]},

{"id":"hotel","p":"stay","name":"Hotel & Stay","kn":"ವಸತಿ","icon":"stay","blurb":"Check in, ask for things, sort out problems.",
"phrases":[
["ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ಬುಕಿಂಗ್ ಇದೆ","nanna hesarinalli booking ide","I have a booking in my name."],
["ರೂಮ್ ಬೇಕು","room beku","I need a room."],
["ಒಂದು ರಾತ್ರಿಗೆ ಎಷ್ಟು?","ondu raatrige eshtu?","How much for one night?"],
["ವೈಫೈ ಪಾಸ್‌ವರ್ಡ್ ಏನು?","wifi password enu?","What is the wifi password?"],
["ಚೆಕ್‌ಔಟ್ ಎಷ್ಟು ಗಂಟೆಗೆ?","checkout eshtu gantege?","What time is checkout?"],
["ಬಿಸಿ ನೀರು ಬರ್ತಿಲ್ಲ","bisi neeru bartilla","There's no hot water."],
["ಎಸಿ ಕೆಲಸ ಮಾಡ್ತಿಲ್ಲ","AC kelasa maadtilla","The AC isn't working."],
["ಇನ್ನೊಂದು ಟವೆಲ್ ಕೊಡಿ","innondu towel kodi","Another towel, please."],
["ರೂಮ್ ಕ್ಲೀನ್ ಮಾಡಿ","room clean maadi","Please clean the room."]],
"convo":[["y","ನನ್ನ ಹೆಸರಿನಲ್ಲಿ ಬುಕಿಂಗ್ ಇದೆ.","nanna hesarinalli booking ide.","I have a booking in my name."],["t","ನಿಮ್ಮ ಹೆಸರು ಏನು?","nimma hesaru enu?","What's your name?"],["y","ನನ್ನ ಹೆಸರು ಆನ್.","nanna hesaru Ann.","My name is Ann."],["t","ಇದು ನಿಮ್ಮ ರೂಮ್ ಕೀ.","idu nimma room key.","This is your room key."],["y","ವೈಫೈ ಪಾಸ್‌ವರ್ಡ್ ಏನು?","wifi password enu?","What is the wifi password?"]],
"tips":["Here a 'lodge' is a budget place to stay and a 'hotel' is a restaurant."],
"avoid":["Don't leave complaints for checkout. Tell the front desk as soon as something's wrong."]},

{"id":"directions","p":"dir","name":"Asking Directions","kn":"ದಾರಿ ಕೇಳುವುದು","icon":"directions","blurb":"Find your way and understand the answer.",
"phrases":[
["ಮೆಟ್ರೋ ಸ್ಟೇಷನ್‌ಗೆ ಹೇಗೆ ಹೋಗಬೇಕು?","metro stationge hege hogabeku?","How do I get to the metro station?"],
["ಇಲ್ಲಿಂದ ಎಷ್ಟು ದೂರ?","illinda eshtu doora?","How far from here?"],
["ಹತ್ತಿರದಲ್ಲಿದೆ","hattiradallide","It's nearby."],
["ತುಂಬಾ ದೂರ","tumba doora","It's very far."],
["ಸಿಗ್ನಲ್ ಹತ್ತಿರ ಎಡಕ್ಕೆ ತಿರುಗಿ","signal hattira edakke thirugi","Turn left at the signal."],
["ಈ ದಾರಿ ಸರಿನಾ?","ee daari sarina?","Is this the right way?"],
["ನನಗೆ ದಾರಿ ಗೊತ್ತಿಲ್ಲ","nanage daari gottilla","I don't know the way."],
["ಸ್ವಲ್ಪ ನಿಧಾನವಾಗಿ ಹೇಳಿ","swalpa nidhaanavaagi heli","Please say it slowly.","Use this right after you ask. Answers come fast."],
["ಮತ್ತೆ ಹೇಳಿ","matte heli","Say it again, please."]],
"convo":[["y","ಮೆಟ್ರೋ ಸ್ಟೇಷನ್ ಎಲ್ಲಿದೆ?","metro station ellide?","Where is the metro station?"],["t","ನೇರವಾಗಿ ಹೋಗಿ. ಸಿಗ್ನಲ್ ಹತ್ತಿರ ಬಲಕ್ಕೆ ತಿರುಗಿ.","neravaagi hogi. signal hattira balakke thirugi.","Go straight. Turn right at the signal."],["y","ಇಲ್ಲಿಂದ ಎಷ್ಟು ದೂರ?","illinda eshtu doora?","How far from here?"],["t","ಹತ್ತಿರದಲ್ಲಿದೆ, ಐದು ನಿಮಿಷ.","hattiradallide, aidu nimisha.","It's nearby, five minutes."]],
"tips":["Ask two people. Locals are helpful but 'nearby' can mean a fair walk."],
"avoid":["Don't just nod when you don't follow. Say 'matte heli'."]},

{"id":"neighbours","p":"nbr","name":"Neighbours & Landlord","kn":"ನೆರೆಹೊರೆಯವರು","icon":"neighbours","blurb":"Be a good neighbour from day one.",
"phrases":[
["ನಾನು ಹೊಸದಾಗಿ ಬಂದಿದ್ದೀನಿ","naanu hosadaagi bandiddeeni","I've just moved here."],
["ನಿಮ್ಮನ್ನ ಭೇಟಿ ಆಗಿ ಖುಷಿ ಆಯ್ತು","nimmanna bheti aagi khushi aaytu","Nice to meet you."],
["ಬಾಡಿಗೆ ಯಾವಾಗ ಕೊಡಬೇಕು?","baadige yaavaaga kodabeku?","When should I pay the rent?"],
["ನೀರು ಬರ್ತಿಲ್ಲ","neeru bartilla","There's no water."],
["ಕರೆಂಟ್ ಹೋಗಿದೆ","current hogide","The power is out."],
["ಕಸ ಯಾವಾಗ ತಗೊಂಡು ಹೋಗ್ತಾರೆ?","kasa yaavaaga tagondu hogtaare?","When is the garbage collected?"],
["ತೊಂದರೆ ಆಗಿದ್ದರೆ ಕ್ಷಮಿಸಿ","tondare aagiddare kshamisi","Sorry if it caused any trouble."],
["ಧನ್ಯವಾದಗಳು","dhanyavaadagalu","Thank you.","In everyday speech many people just say 'thanks'. Both are fine."],
["ಒಂದು ಸಹಾಯ ಮಾಡ್ತೀರಾ?","ondu sahaaya maadteeraa?","Could you help me with something?"]],
"convo":[["y","ನಮಸ್ಕಾರ! ನಾನು ಹೊಸದಾಗಿ ಬಂದಿದ್ದೀನಿ.","namaskaara! naanu hosadaagi bandiddeeni.","Hello! I've just moved here."],["t","ಸ್ವಾಗತ! ಏನಾದ್ರೂ ಸಹಾಯ ಬೇಕಾ?","swaagata! enaadru sahaaya bekaa?","Welcome! Need any help?"],["y","ಕಸ ಯಾವಾಗ ತಗೊಂಡು ಹೋಗ್ತಾರೆ?","kasa yaavaaga tagondu hogtaare?","When is the garbage collected?"],["t","ಬೆಳಿಗ್ಗೆ ಎಂಟು ಗಂಟೆಗೆ.","beligge entu gantege.","At eight in the morning."]],
"tips":["A greeting on the stairs goes a long way. Neighbours often look out for new people."],
"avoid":["Don't skip greeting the landlord's family. Say 'namaskaara' first, then business."]},

{"id":"office","p":"off","name":"Office & College","kn":"ಆಫೀಸ್ ಮತ್ತು ಕಾಲೇಜು","icon":"office","blurb":"Small talk and everyday requests at work or class.",
"phrases":[
["ನಾನು ಇಲ್ಲಿ ಹೊಸದಾಗಿ ಸೇರಿದ್ದೀನಿ","naanu illi hosadaagi serideeni","I joined here recently."],
["ಇದನ್ನ ಇಂಗ್ಲಿಷ್‌ನಲ್ಲಿ ಹೇಳಬಹುದಾ?","idanna englishnalli helabahudaa?","Can you say this in English?"],
["ಮೀಟಿಂಗ್ ಎಷ್ಟು ಗಂಟೆಗೆ?","meeting eshtu gantege?","What time is the meeting?"],
["ಇದು ನನಗೆ ಅರ್ಥ ಆಗಲಿಲ್ಲ","idu nanage artha aagalilla","I didn't understand this."],
["ಒಂದು ನಿಮಿಷ","ondu nimisha","One minute."],
["ಕ್ಲಾಸ್ ಎಲ್ಲಿದೆ?","class ellide?","Where is the class?"],
["ಊಟಕ್ಕೆ ಬರ್ತೀರಾ?","ootakke barteeraa?","Coming for lunch?"],
["ನಾಳೆ ಭೇಟಿ ಆಗೋಣ","naale bheti aagona","Let's meet tomorrow."],
["ಸ್ವಲ್ಪ ಸಹಾಯ ಬೇಕು","swalpa sahaaya beku","I need a little help."],
["ಸ್ವಲ್ಪ ಸ್ವಲ್ಪ ಕನ್ನಡ ಬರುತ್ತೆ","swalpa swalpa kannada baruttade","I know a little Kannada.","Colleagues love hearing this and will often slow down for you."]],
"convo":[["t","ಊಟಕ್ಕೆ ಬರ್ತೀರಾ?","ootakke barteeraa?","Coming for lunch?"],["y","ಹೌದು, ಒಂದು ನಿಮಿಷ.","haudu, ondu nimisha.","Yes, one minute."],["t","ಕನ್ನಡ ಬರುತ್ತಾ?","kannada baruttaa?","Do you know Kannada?"],["y","ಸ್ವಲ್ಪ ಸ್ವಲ್ಪ ಬರುತ್ತೆ.","swalpa swalpa baruttade.","A little."]],
"tips":["Office language is often English, but lunch-table talk is Kannada. Trying helps."],
"avoid":["Don't apologise for not knowing Kannada every time. Say 'swalpa swalpa baruttade' and carry on."]},

{"id":"bank-gov","p":"bank","name":"Bank & Government Offices","kn":"ಬ್ಯಾಂಕ್ ಮತ್ತು ಸರ್ಕಾರಿ ಕಚೇರಿ","icon":"bank","blurb":"Forms, counters and queues.",
